# the PFN_vkInternalAllocationNotification callback signature
pub def InternalAllocationNotification: fun(ptr, u64, i32, i32);
# the PFN_vkInternalFreeNotification callback signature
pub def InternalFreeNotification: fun(ptr, u64, i32, i32);
# the PFN_vkReallocationFunction callback signature
pub def ReallocationFunction: fun(ptr, ptr, u64, u64, i32) ptr;
